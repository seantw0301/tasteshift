# Optional. Prefer `qloo setup --qloo`, which keeps the key in the harness's private config.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
CORS_ORIGINS=http://localhost:3000

# Deployment (scripts/deploy.sh). Keep real host details in .env, not in the repo.
DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_WEB_DIR=
DEPLOY_API_DIR=/opt/tasteshift-api
DEPLOY_BASE_PATH=/tasteshift
DEPLOY_ORIGIN=
DEPLOY_NGINX_EXT_DIR=
DEPLOY_API_PORT=8010
